# Translation provider fallback order: Google → DeepL → LibreTranslate.
# Set one or more values in Vercel Project Settings → Environment Variables.
# Do not expose these values as VITE_* variables.

GOOGLE_TRANSLATE_API_KEY=

# Optional. Use https://api-free.deepl.com/v2/translate for API Free,
# or set DEEPL_API_URL=https://api.deepl.com/v2/translate for a paid account.
DEEPL_API_KEY=
DEEPL_API_URL=

# Optional self-hosted privacy fallback, e.g. https://translate.example.com
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
